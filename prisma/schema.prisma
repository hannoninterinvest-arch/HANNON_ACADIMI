generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

enum StatutSession {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum StatutLicence {
  LIBRE
  OCCUPE
}

enum RoleCompte {
  ADMIN
  FORMATEUR
  ETUDIANT_B2C
  SOCIETE
  EMPLOYE
}

model Compte {
  id          String     @id @default(cuid())
  email       String     @unique
  nom         String
  motDePasse  String
  role        RoleCompte
  societeId   String?
  formateurId String?    @unique
  etudiantId  String?    @unique
  createdAt   DateTime   @default(now())

  societe   Societe?   @relation(fields: [societeId], references: [id], onDelete: SetNull)
  formateur Formateur? @relation(fields: [formateurId], references: [id], onDelete: SetNull)
  etudiant  Etudiant?  @relation(fields: [etudiantId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([societeId])
}

model Societe {
  id        String        @id @default(cuid())
  nom       String
  email     String        @unique
  createdAt DateTime      @default(now())
  comptes   Compte[]
  achats    AchatPlaces[]
}

/// Achat B2B : N places pour un cours, ensuite assignées à des employés.
model AchatPlaces {
  id        String   @id @default(cuid())
  societeId String
  coursId   String
  nbPlaces  Int
  createdAt DateTime @default(now())

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)
  cours   Cours   @relation(fields: [coursId], references: [id], onDelete: Restrict)

  @@index([societeId])
  @@index([coursId])
}

model Formateur {
  id        String   @id @default(cuid())
  nom       String
  email     String   @unique
  createdAt DateTime @default(now())

  emploisDuTemps EmploiDuTemps[]
  compte         Compte?
}

model Cours {
  id          String   @id @default(cuid())
  titre       String
  description String?
  ouvertB2c   Boolean  @default(true)
  createdAt   DateTime @default(now())

  emploisDuTemps EmploiDuTemps[]
  inscriptions   Inscription[]
  achats         AchatPlaces[]
}

model Etudiant {
  id        String   @id @default(cuid())
  nom       String
  email     String   @unique
  createdAt DateTime @default(now())

  inscriptions Inscription[]
  compte       Compte?
}

model Inscription {
  id         String   @id @default(cuid())
  etudiantId String
  coursId    String
  createdAt  DateTime @default(now())

  etudiant Etudiant @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  cours    Cours    @relation(fields: [coursId], references: [id], onDelete: Cascade)

  @@unique([etudiantId, coursId])
  @@index([coursId])
}

model EmploiDuTemps {
  id               String      @id @default(cuid())
  coursId          String
  formateurId      String
  jourSemaine      JourSemaine
  heureDebut       String
  dureeMinutes     Int
  dateDebutPeriode DateTime    @db.Date
  dateFinPeriode   DateTime    @db.Date
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  cours     Cours     @relation(fields: [coursId], references: [id], onDelete: Restrict)
  formateur Formateur @relation(fields: [formateurId], references: [id], onDelete: Restrict)
  sessions  Session[]

  @@index([formateurId])
  @@index([coursId])
}

model Session {
  id              String        @id @default(cuid())
  emploiDuTempsId String
  dateReelle      DateTime
  zoomMeetingId   String?
  joinUrl         String?
  hostKey         String?
  statut          StatutSession @default(PLANIFIEE)
  licenceZoomId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  emploiDuTemps    EmploiDuTemps @relation(fields: [emploiDuTempsId], references: [id], onDelete: Restrict)
  licenceZoom      LicenceZoom?  @relation("SessionLicenceAssignee", fields: [licenceZoomId], references: [id], onDelete: SetNull)
  licenceOccupante LicenceZoom?  @relation("LicenceSessionEnCours")

  @@unique([emploiDuTempsId, dateReelle])
  @@index([statut])
  @@index([dateReelle])
  @@index([zoomMeetingId])
  @@index([licenceZoomId])
}

model LicenceZoom {
  id               String        @id @default(cuid())
  compteEmail      String        @unique
  zoomUserId       String        @unique
  statut           StatutLicence @default(LIBRE)
  hostKey          String?
  sessionIdEnCours String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessionEnCours Session?  @relation("LicenceSessionEnCours", fields: [sessionIdEnCours], references: [id], onDelete: SetNull)
  sessions       Session[] @relation("SessionLicenceAssignee")

  @@index([statut])
}
