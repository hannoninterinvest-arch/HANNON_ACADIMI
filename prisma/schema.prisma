generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

enum StatutSession {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum StatutLicence {
  LIBRE
  OCCUPE
}

enum RoleCompte {
  ADMIN
  FORMATEUR
  ETUDIANT_B2C
  SOCIETE
  EMPLOYE
}

enum TypeOrganisation {
  ENTREPRISE
  ORGANISME_PUBLIC
}

enum RoleAppartenance {
  RESPONSABLE
  APPRENANT
}

enum StatutOuvertureSession {
  OUVERTE
  FERMEE
  COMPLETE
  ANNULEE
}

enum StatutCommande {
  EN_ATTENTE
  PAYEE
  ECHOUEE
  ANNULEE
  REMBOURSEE
}

enum ProfilTarif {
  B2C
  B2B
  B2G
}

enum TypeRemise {
  POURCENTAGE
  MONTANT_FIXE
}

enum StatutReservation {
  ACTIVE
  CONFIRMEE
  LIBEREE
  EXPIREE
}

enum TypeAcheteur {
  PARTICULIER
  ORGANISATION
}

enum StatutDemande {
  NOUVELLE
  EN_COURS
  PROPOSITION_ENVOYEE
  CLOTUREE
}

model Compte {
  id          String     @id @default(cuid())
  email       String     @unique
  nom         String
  motDePasse  String
  role        RoleCompte
  societeId   String?
  formateurId String?    @unique
  etudiantId  String?    @unique
  createdAt   DateTime   @default(now())

  societe      Societe?       @relation(fields: [societeId], references: [id], onDelete: SetNull)
  formateur    Formateur?     @relation(fields: [formateurId], references: [id], onDelete: SetNull)
  etudiant     Etudiant?      @relation(fields: [etudiantId], references: [id], onDelete: SetNull)
  appartenances Appartenance[]
  commandes    Commande[]
  affectations Affectation[]
  certificats  Certificat[]

  @@index([role])
  @@index([societeId])
}

model Societe {
  id        String            @id @default(cuid())
  nom       String
  email     String            @unique
  type      TypeOrganisation  @default(ENTREPRISE)
  telephone String?
  createdAt DateTime          @default(now())

  comptes       Compte[]
  achats        AchatPlaces[]
  appartenances Appartenance[]
  commandes     Commande[]
  affectations  Affectation[]
  invitations   Invitation[]
  demandes      DemandeFormation[]
}

/// Achat B2B historique (avant commandes payées). Conservé pour les données existantes.
model AchatPlaces {
  id        String   @id @default(cuid())
  societeId String
  coursId   String
  nbPlaces  Int
  createdAt DateTime @default(now())

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)
  cours   Cours   @relation(fields: [coursId], references: [id], onDelete: Restrict)

  @@index([societeId])
  @@index([coursId])
}

model Appartenance {
  id        String           @id @default(cuid())
  compteId  String
  societeId String
  role      RoleAppartenance
  createdAt DateTime         @default(now())

  compte  Compte  @relation(fields: [compteId], references: [id], onDelete: Cascade)
  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@unique([compteId, societeId])
  @@index([societeId, role])
}

model Invitation {
  id               String    @id @default(cuid())
  societeId        String
  email            String
  nom              String
  jetonHash        String    @unique
  expireLe         DateTime
  accepteeLe       DateTime?
  compteExistantId String?
  createdAt        DateTime  @default(now())

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@index([societeId, email])
}

model Formateur {
  id        String   @id @default(cuid())
  nom       String
  email     String   @unique
  createdAt DateTime @default(now())

  emploisDuTemps   EmploiDuTemps[]
  compte           Compte?
  sessionsAnimees  Session[]       @relation("SessionFormateur")
}

model Cours {
  id          String   @id @default(cuid())
  titre       String
  description String?
  horaire     String?
  imageChemin String?
  ouvertB2c   Boolean  @default(true)
  createdAt   DateTime @default(now())

  emploisDuTemps       EmploiDuTemps[]
  inscriptions         Inscription[]
  achats               AchatPlaces[]
  sessionsCommerciales Session[]          @relation("SessionsCommerciales")
  tarif                TarifFormation?
  commandes            Commande[]
  demandes             DemandeFormation[]
  ressources           RessourceCours[]
  certificats          Certificat[]
}

model TarifFormation {
  id                         String @id @default(cuid())
  coursId                    String @unique
  prixB2cCentimes            Int
  prixOrganisationCentimes   Int
  devise                     String @default("EUR")
  updatedAt                  DateTime @updatedAt

  cours  Cours        @relation(fields: [coursId], references: [id], onDelete: Cascade)
  regles RegleRemise[]
}

model RegleRemise {
  id             String      @id @default(cuid())
  tarifId        String
  seuilQuantite  Int         @default(10)
  typeRemise     TypeRemise
  valeur         Int
  profils        ProfilTarif[]
  actif          Boolean     @default(true)

  tarif TarifFormation @relation(fields: [tarifId], references: [id], onDelete: Cascade)

  @@index([tarifId])
}

model Etudiant {
  id        String   @id @default(cuid())
  nom       String
  email     String   @unique
  createdAt DateTime @default(now())

  inscriptions Inscription[]
  compte       Compte?
}

model Inscription {
  id         String   @id @default(cuid())
  etudiantId String
  coursId    String
  createdAt  DateTime @default(now())

  etudiant Etudiant @relation(fields: [etudiantId], references: [id], onDelete: Cascade)
  cours    Cours    @relation(fields: [coursId], references: [id], onDelete: Cascade)

  @@unique([etudiantId, coursId])
  @@index([coursId])
}

model EmploiDuTemps {
  id               String      @id @default(cuid())
  coursId          String
  formateurId      String
  jourSemaine      JourSemaine
  heureDebut       String
  dureeMinutes     Int
  dateDebutPeriode DateTime    @db.Date
  dateFinPeriode   DateTime    @db.Date
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  cours     Cours     @relation(fields: [coursId], references: [id], onDelete: Restrict)
  formateur Formateur @relation(fields: [formateurId], references: [id], onDelete: Restrict)
  sessions  Session[]

  @@index([formateurId])
  @@index([coursId])
}

model Session {
  id                 String                  @id @default(cuid())
  emploiDuTempsId    String?
  coursId            String?
  formateurId        String?
  dateReelle         DateTime
  dateFin            DateTime?
  fuseauHoraire      String                  @default("Europe/Paris")
  capaciteMax        Int                     @default(12)
  statutInscription  StatutOuvertureSession  @default(FERMEE)
  lienZoomManuel     String?
  codeReunion        String?
  zoomMeetingId      String?
  joinUrl            String?
  hostKey            String?
  statut             StatutSession           @default(PLANIFIEE)
  licenceZoomId      String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  emploiDuTemps    EmploiDuTemps? @relation(fields: [emploiDuTempsId], references: [id], onDelete: Restrict)
  cours            Cours?         @relation("SessionsCommerciales", fields: [coursId], references: [id], onDelete: Restrict)
  formateur        Formateur?     @relation("SessionFormateur", fields: [formateurId], references: [id], onDelete: SetNull)
  licenceZoom      LicenceZoom?   @relation("SessionLicenceAssignee", fields: [licenceZoomId], references: [id], onDelete: SetNull)
  licenceOccupante LicenceZoom?   @relation("LicenceSessionEnCours")
  commandes        Commande[]
  reservations     ReservationPlaces[]
  affectations     Affectation[]
  certificats      Certificat[]

  @@unique([emploiDuTempsId, dateReelle])
  @@index([statut])
  @@index([dateReelle])
  @@index([zoomMeetingId])
  @@index([licenceZoomId])
  @@index([coursId])
  @@index([statutInscription])
}

model LicenceZoom {
  id               String        @id @default(cuid())
  compteEmail      String        @unique
  zoomUserId       String        @unique
  statut           StatutLicence @default(LIBRE)
  hostKey          String?
  sessionIdEnCours String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessionEnCours Session?  @relation("LicenceSessionEnCours", fields: [sessionIdEnCours], references: [id], onDelete: SetNull)
  sessions       Session[] @relation("SessionLicenceAssignee")

  @@index([statut])
}

model Commande {
  id                      String         @id @default(cuid())
  reference               String         @unique
  compteId                String
  societeId               String?
  coursId                 String
  sessionId               String
  quantite                Int
  prixUnitaireCentimes    Int
  remiseUnitaireCentimes  Int
  totalCentimes           Int
  devise                  String         @default("EUR")
  statut                  StatutCommande @default(EN_ATTENTE)
  typeAcheteur            TypeAcheteur
  profilTarif             ProfilTarif
  seuilApplique           Int?
  typeRemiseApplique      TypeRemise?
  valeurRemiseAppliquee   Int?
  libelleRemise           String?
  fournisseurPaiement     String
  referenceFournisseur    String?        @unique
  payeeLe                 DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  compte       Compte              @relation(fields: [compteId], references: [id], onDelete: Restrict)
  societe      Societe?            @relation(fields: [societeId], references: [id], onDelete: Restrict)
  cours        Cours               @relation(fields: [coursId], references: [id], onDelete: Restrict)
  session      Session             @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  reservation  ReservationPlaces?
  affectations Affectation[]

  @@index([sessionId, statut])
  @@index([societeId, sessionId])
  @@index([compteId])
}

model ReservationPlaces {
  id         String            @id @default(cuid())
  sessionId  String
  commandeId String            @unique
  quantite   Int
  expireLe   DateTime
  statut     StatutReservation @default(ACTIVE)
  createdAt  DateTime          @default(now())

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@index([sessionId, statut, expireLe])
}

model Affectation {
  id         String   @id @default(cuid())
  commandeId String
  societeId  String
  sessionId  String
  compteId   String
  createdAt  DateTime @default(now())

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  societe  Societe  @relation(fields: [societeId], references: [id], onDelete: Restrict)
  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  compte   Compte   @relation(fields: [compteId], references: [id], onDelete: Restrict)

  @@unique([sessionId, compteId])
  @@index([commandeId])
  @@index([societeId, sessionId])
}

model DemandeFormation {
  id                String        @id @default(cuid())
  societeId         String?
  organisationNom   String
  contactNom        String
  email             String
  telephone         String
  coursId           String?
  sujetPersonnalise String?
  nbParticipants    Int
  periodeSouhaitee  String
  message           String
  statut            StatutDemande @default(NOUVELLE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  societe Societe? @relation(fields: [societeId], references: [id], onDelete: SetNull)
  cours   Cours?   @relation(fields: [coursId], references: [id], onDelete: SetNull)

  @@index([statut])
}

model RessourceCours {
  id             String   @id @default(cuid())
  coursId        String
  titre          String
  description    String?
  nomFichier     String
  cheminStockage String
  typeMime       String
  createdAt      DateTime @default(now())

  cours Cours @relation(fields: [coursId], references: [id], onDelete: Cascade)

  @@index([coursId])
}

model Certificat {
  id             String   @id @default(cuid())
  compteId       String
  coursId        String
  sessionId      String?
  titre          String
  nomFichier     String
  cheminStockage String
  typeMime       String
  emisLe         DateTime @default(now())

  compte  Compte   @relation(fields: [compteId], references: [id], onDelete: Cascade)
  cours   Cours    @relation(fields: [coursId], references: [id], onDelete: Restrict)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([compteId])
  @@index([coursId])
}
