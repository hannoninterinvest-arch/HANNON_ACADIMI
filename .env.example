# =============================================================================
# HANNON ACADIMI — variables d'environnement
# Copier ce fichier vers .env et renseigner les valeurs.
# Ne jamais committer le fichier .env.
# =============================================================================

# --- Base de données ---
# Neon Console > projet > Connect
# DATABASE_URL = chaîne « pooled » (hôte avec suffixe -pooler, recommandé pour l'app)
# DIRECT_URL   = chaîne « direct » (sans -pooler) — obligatoire pour prisma migrate
# Format : postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
DIRECT_URL=

# --- Zoom API (Server-to-Server OAuth) ---
# Zoom Marketplace > Develop > Build App > Server-to-Server OAuth
# https://marketplace.zoom.us/develop/create
# Onglet App Credentials : Account ID, Client ID, Client Secret
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Zoom Webhooks ---
# Zoom Marketplace > ton app > Feature > Event Subscriptions
# Secret Token affiché pour la souscription d'événements
# Endpoint à déclarer : {NEXT_PUBLIC_APP_URL}/api/webhooks/zoom
# Événements : meeting.started, meeting.ended
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Sécurité interne ---
# Chaîne aléatoire pour authentifier le cron (ex: openssl rand -hex 32)
# Header : Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Secret des sessions de connexion (peut réutiliser CRON_SECRET en secours)
AUTH_SECRET=

# --- Email (Resend) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Expéditeur vérifié dans Resend (domaine ou onboarding@resend.dev en test)
RESEND_FROM_EMAIL="Hannon Acadimi <noreply@example.com>"
# Destinataire des alertes ops (pool de licences saturé, erreurs Zoom)
ALERT_EMAIL=

# --- URL de l'application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Planification ---
# Fuseau horaire des cours (IANA). Les lundis 18h sont interprétés dans ce TZ.
APP_TIMEZONE=Europe/Paris
# Fenêtre glissante de création des réunions Zoom (entre 7 et 14 jours)
SESSION_HORIZON_JOURS=14
